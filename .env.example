# Postgres (password shared by docker compose and the ETL)
DB_PASSWORD=change-me
# Optional overrides (defaults shown). With docker compose use ETL_DB_PORT=5433.
# ETL_DB_HOST=localhost
# ETL_DB_PORT=5433   # docker compose default
# ETL_DB_NAME=ADHOC_GOLF
# ETL_DB_USER=postgres

# Redis payload cache (ETL degrades gracefully if unreachable)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=21600
# CURRENT_SEASON_TTL_SECONDS=3600   # how stale current-season stats may be

# Polite scraping
# REQUESTS_PER_SECOND=2
# MAX_RETRIES=4

# PGA Tour GraphQL key (the public key the website ships to browsers). Do not commit the real value.
PGA_GRAPHQL_KEY=
