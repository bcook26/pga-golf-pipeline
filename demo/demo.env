# Settings for the one-command demo (scripts/demo.sh). Not for real deployments.
# Uses its own compose project and ports so it never collides with a dev stack.
DB_PASSWORD=demo-only-not-a-secret
ETL_DB_USER=postgres
ETL_DB_NAME=ADHOC_GOLF
POSTGRES_HOST_PORT=15433
REDIS_HOST_PORT=16379
API_HOST_PORT=8100
WEB_HOST_PORT=3100
PUBLIC_API_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:3100
# Only reachable from this machine
BIND_ADDRESS=127.0.0.1
# The seed is a snapshot, so never flag it as stale (10 years)
PIPELINE_STALE_AFTER_HOURS=87600
PGA_GRAPHQL_KEY=
